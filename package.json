{
  "name": "react-ui-componentes",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "./dist/react-ui-componentes.cjs.js",
  "module": "./dist/react-ui-componentes.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/index.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-ui-componentes.es.js",
      "require": "./dist/react-ui-componentes.cjs.js"
    },
    "./dist/react-ui-componentes.css": "./dist/react-ui-componentes.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "cp src/index.d.ts dist/index.d.ts",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/react-ui-componentes.css",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.2 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/cli": "4.3.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "esbuild": "^0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "neostandard": "0.13.0",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vite-plugin-css-injected-by-js": "5.0.1"
  },
  "overrides": {
    "minimatch": "10.2.1"
  }
}
